# Copy for development; scripts/dev-env.py generates unique secrets and these values.
ENVIRONMENT=development
BASE_URL=http://localhost:8080
COOKIE_SECURE=false
MOCK_MODE=true
REGISTRATION_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SECRET_KEY=GENERATE_WITH_DEV_ENV_SCRIPT
ENCRYPTION_KEYS=GENERATE_WITH_DEV_ENV_SCRIPT
POSTGRES_PASSWORD=GENERATE_WITH_DEV_ENV_SCRIPT
DATABASE_URL=postgresql+psycopg://nexa:GENERATE_WITH_DEV_ENV_SCRIPT@postgres:5432/nexa
REDIS_URL=redis://redis:6379/0
DATA_DIR=./runtime
CADDY_SITE=:80
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v26.0
EXCHANGE_PROVIDER=tgju_sana
EXCHANGE_CACHE_TTL=86400
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
